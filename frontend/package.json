{
  "name": "dashboard-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/validate-prod-env.mjs && tsc -b && vite build --outDir .tmp/build-check --emptyOutDir",
    "build:prod": "node ./scripts/validate-prod-env.mjs && tsc -b && vite build --outDir dist-prod --emptyOutDir",
    "check:encoding": "node ./scripts/check-encoding.mjs",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview",
    "start:prod": "node ./scripts/start-prod-static.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.16.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
